#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
for file in exitcode-operation.mjs exitcode-core.mjs exitcode-evaluator.mjs exitcode-preparation.mjs exitcode-quality.mjs exitcode-parallel.mjs exitcode-workers.mjs \
  exitcode.ts scripts/benchmark-evaluator.mjs scripts/smoke-workers.mjs ./*.test.mjs test/*.mjs; do
  node --check "$file"
done
npm test
